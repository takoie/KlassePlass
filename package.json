{
  "name": "klasseplass",
  "version": "2.2.0",
  "description": "Verktøy for organisering av klassekart",
  "author": "Stian Taknes",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "vite": "vite",
    "dev": "concurrently \"vite\" \"wait-on http://localhost:3000 && electron .\"",
    "build": "vite build && electron-builder",
    "dist": "vite build && electron-builder",
    "test": "node --test"
  },
  "license": "ISC",
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fortawesome/fontawesome-free": "^6.5.2",
    "@tauri-apps/api": "^2.11.1",
    "electron-updater": "^6.8.9",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sql.js": "^1.10.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "daisyui": "^4.10.2",
    "electron": "^43.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "vite": "^5.2.11",
    "wait-on": "^7.2.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/takoie/klasseplass"
  },
  "build": {
    "appId": "com.klasseplass.app",
    "productName": "KlassePlass",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "artifactName": "KlassePlass.Setup.${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KlassePlass"
    },
    "files": [
      "**/*",
      "!.worktrees/**",
      "!docs/**",
      "!*.config.js",
      "!src/**/*.jsx",
      "!src/styles/**"
    ]
  }
}
