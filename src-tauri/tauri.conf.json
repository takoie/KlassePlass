{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "KlassePlass",
  "version": "../package.json",
  "identifier": "com.klasseplass.app",
  "build": {
    "beforeDevCommand": "npm run vite",
    "beforeBuildCommand": "npm run vite -- build",
    "frontendDist": "../dist-react",
    "devUrl": "http://localhost:3000"
  },
  "app": {
    "windows": [
      {
        "title": "KlassePlass",
        "width": 1280,
        "height": 800,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/takoie/KlassePlass/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI3RTVBMjQ2QjQwMjc1QzYKUldUR2RRSzBScUxsSjlQNDdNejA1NUhHQ0tZU2tXK1JNeXRCNUw5R09xY1hvUXQxR3E3bDVUS0cK"
    }
  }
}
